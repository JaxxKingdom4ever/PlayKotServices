                timerSeconds: 120,
                progressPct: 0,
                stallResolved: false
            };

            const months = [
                "January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December"
            ];

            const playerIdInput = document.getElementById('playerIdInput');
            const peekPasswordBtn = document.getElementById('peekPasswordBtn');
            const annoyingTooltip = document.getElementById('annoyingTooltip');
            const tooltipCloseBtn = document.getElementById('tooltipCloseBtn');
            const reopenHelpBtn = document.getElementById('reopenHelpBtn');
            const blurResetNotice = document.getElementById('blurResetNotice');
            const errorConsole = document.getElementById('errorConsole');
            const errorMessage = document.getElementById('errorMessage');
            const dismissErrorBtn = document.getElementById('dismissErrorBtn');
            const warnConsole = document.getElementById('warnConsole');

            const serverNodeSelect = document.getElementById('serverNodeSelect');
