            const nextMonthBtn = document.getElementById('nextMonthBtn');
            const epochDateDisplay = document.getElementById('epochDateDisplay');
            const epochClicksRemaining = document.getElementById('epochClicksRemaining');
            const dateClickCounterText = document.getElementById('dateClickCounterText');
            const bypassEpochBtn = document.getElementById('bypassEpochBtn');

            const chkActiveProfile = document.getElementById('chkActiveProfile');
            const chkReadAccess = document.getElementById('chkReadAccess');
            const fakeLabel1 = document.getElementById('fakeLabel1');
            const fakeLabel2 = document.getElementById('fakeLabel2');
            const hitboxHint1 = document.getElementById('hitboxHint1');
            const checkboxCascadeNotice = document.getElementById('checkboxCascadeNotice');

            const submitBackupBtn = document.getElementById('submitBackupBtn');
            const cookieBanner = document.getElementById('cookieBanner');
            const cookieLegalBox = document.getElementById('cookieLegalBox');
            const acceptCookiesBtn = document.getElementById('acceptCookiesBtn');
            const manageCookiesBtn = document.getElementById('manageCookiesBtn');
            const cookiePrefsPanel = document.getElementById('cookiePrefsPanel');

            const sessionTimer = document.getElementById('sessionTimer');
            const networkDegradedBanner = document.getElementById('networkDegradedBanner');

            const formContainer = document.getElementById('formContainer');
            const processingContainer = document.getElementById('processingContainer');
            const revealContainer = document.getElementById('revealContainer');
            const progressBarFill = document.getElementById('progressBarFill');
            const progressPercentText = document.getElementById('progressPercentText');
            const consoleLogBox = document.getElementById('consoleLogBox');
            const assetCounterText = document.getElementById('assetCounterText');
            const stallModal = document.getElementById('stallModal');
            const keepWaitingBtn = document.getElementById('keepWaitingBtn');
            const cancelOperationBtn = document.getElementById('cancelOperationBtn');
            const deadTabRestore = document.getElementById('deadTabRestore');
            const deadTabDiag = document.getElementById('deadTabDiag');
            const kbLinkBtn = document.getElementById('kbLinkBtn');

            document.querySelectorAll('img').forEach(img => {
                if (img.complete && img.naturalWidth === 0) {
                    img.onerror();
                }
            });

            function showError(msg) {
                state.snagCount++;
                errorMessage.textContent = msg;
                errorConsole.classList.remove('hidden');
                playSubtleBeep();
            }

            function hideError() {
                errorConsole.classList.add('hidden');
            }

            if (dismissErrorBtn) dismissErrorBtn.addEventListener('click', hideError);

            if (deadTabRestore) {
                deadTabRestore.addEventListener('click', () => {
                    showError("Module Locked (0x31): Complete [1] Local Cache Backup before restoring an .SCB archive.");
                });
            }
            if (deadTabDiag) {
                deadTabDiag.addEventListener('click', () => {
                    showError("Access Denied: Shard Ping Diagnostics requires Municipal Administrator clearance.");
                });
            }
            if (kbLinkBtn) {
                kbLinkBtn.addEventListener('click', () => {
                    showError("HTTP 404: Help article #KB-4091 was archived during the 2014 Playkot forum migration.");
                });
            }

            function playSubtleBeep() {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(800, ctx.currentTime);
                    gain.gain.setValueAtTime(0.03, ctx.currentTime);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.06);
                } catch (e) {}
            }

            setInterval(() => {
                if (Date.now() - state.startTime > 240000) {
                    state.mercyMode = true;
                }
            }, 5000);

            setInterval(() => {
                state.timerSeconds--;
                if (state.timerSeconds <= 0) {
                    state.timerSeconds = 120;
                    state.snagCount++;
                    if (networkDegradedBanner) networkDegradedBanner.classList.remove('hidden');
                }
                const mins = String(Math.floor(state.timerSeconds / 60)).padStart(2, '0');
                const secs = String(state.timerSeconds % 60).padStart(2, '0');
                if (sessionTimer) sessionTimer.textContent = `${mins}:${secs}`;
            }, 1000);

            if (playerIdInput) {
                playerIdInput.addEventListener('focus', () => {
                    if (!state.hasShownTooltip && annoyingTooltip) {
                        annoyingTooltip.style.top = '-6px';
                        annoyingTooltip.style.left = '8px';
                        annoyingTooltip.style.right = '8px';
                        annoyingTooltip.classList.remove('hidden');
                        state.hasShownTooltip = true;
                    }
                });

                playerIdInput.addEventListener('blur', () => {
                    if (!state.hasClearedOnBlur && playerIdInput.value.length > 0 && !state.mercyMode) {
                        playerIdInput.value = '';
                        state.hasClearedOnBlur = true;
                        state.snagCount++;
                        if (blurResetNotice) blurResetNotice.classList.remove('hidden');
                        setTimeout(() => {
                            if (blurResetNotice) blurResetNotice.classList.add('hidden');
                        }, 5000);
                    }
                });

                playerIdInput.addEventListener('keydown', (e) => {
                    if (e.key.toUpperCase() === 'O' && !state.mercyMode) {
                        e.preventDefault();
                        showError("Policy Violation: Alphabetic character 'O' is reserved. Please use numeric '0'.");
                    }
                });

                playerIdInput.addEventListener('paste', (e) => {
                    if (!state.mercyMode) {
                        e.preventDefault();
                        showError("Security Alert 0x12: Direct context menu paste blocked. Type ID manually.");
                    }
                });
            }

            if (reopenHelpBtn && annoyingTooltip) {
                reopenHelpBtn.addEventListener('click', () => {
                    state.tooltipDodges = 0;
                    annoyingTooltip.style.top = '-6px';
                    annoyingTooltip.style.left = '8px';
                    annoyingTooltip.style.right = '8px';
                    annoyingTooltip.classList.remove('hidden');
                });
            }

            function dodgeTooltip(e) {
                if (state.tooltipDodges < 2 && !state.mercyMode && annoyingTooltip) {
                    e.preventDefault();
                    e.stopPropagation();
                    state.tooltipDodges++;
                    state.snagCount++;
                    if (state.tooltipDodges === 1) {
                        annoyingTooltip.style.top = '26px';
                        annoyingTooltip.style.left = '22px';
                        annoyingTooltip.style.right = '-6px';
                    } else {
                        annoyingTooltip.style.top = '-18px';
                        annoyingTooltip.style.left = '-4px';
                        annoyingTooltip.style.right = '18px';
                    }
                } else if (annoyingTooltip) {
                    annoyingTooltip.classList.add('hidden');
                }
            }

            if (tooltipCloseBtn) {
                tooltipCloseBtn.addEventListener('mousedown', dodgeTooltip);
                tooltipCloseBtn.addEventListener('touchstart', dodgeTooltip, { passive: false });
                tooltipCloseBtn.addEventListener('click', () => {
                    if ((state.tooltipDodges >= 2 || state.mercyMode) && annoyingTooltip) {
                        annoyingTooltip.classList.add('hidden');
                    }
                });
            }

            if (peekPasswordBtn && playerIdInput) {
                peekPasswordBtn.addEventListener('mousedown', () => {
                    playerIdInput.type = 'text';
                    setTimeout(() => {
                        playerIdInput.type = 'password';
                    }, 800);
                });
                peekPasswordBtn.addEventListener('touchstart', (e) => {
                    e.preventDefault();
                    playerIdInput.type = 'text';
                    setTimeout(() => {
                        playerIdInput.type = 'password';
                    }, 800);
                });
            }

            function updateEpochDisplay() {
                if (epochDateDisplay) {
                    epochDateDisplay.textContent = `${months[state.currentMonth]} 15, ${state.currentYear}`;
                }
                const monthsElapsed = (state.currentYear - 1970) * 12 + state.currentMonth;
                const remaining = Math.max(0, 681 - monthsElapsed);
                if (epochClicksRemaining) {
                    epochClicksRemaining.textContent = `Delta: ${remaining} months behind server clock`;
                }
                if (dateClickCounterText) {
                    dateClickCounterText.textContent = `Manual steps: ${state.manualDateClicks}`;
                }
            }

            if (prevMonthBtn) {
                prevMonthBtn.addEventListener('click', () => {
                    state.manualDateClicks++;
                    state.currentMonth--;
                    if (state.currentMonth < 0) {
                        state.currentMonth = 11;
                        state.currentYear--;
                        if (state.currentYear < 1965) state.currentYear = 1965;
                    }
                    updateEpochDisplay();
                });
            }

            if (nextMonthBtn) {
                nextMonthBtn.addEventListener('click', () => {
                    state.manualDateClicks++;
                    state.currentMonth++;
                    if (state.currentMonth > 11) {
                        state.currentMonth = 0;
                        state.currentYear++;
                    }
                    updateEpochDisplay();
                    if (state.manualDateClicks >= 5 && bypassEpochBtn) {
                        bypassEpochBtn.classList.add('text-[#0000ee]', 'font-bold');
                    }
                });
            }

            if (bypassEpochBtn) {
                bypassEpochBtn.addEventListener('click', () => {
                    state.dateSynced = true;
                    state.currentYear = 2026;
                    state.currentMonth = 9; // October
                    updateEpochDisplay();
                    if (epochDateDisplay) epochDateDisplay.textContent = "October 15, 2026 (Synced)";
                    if (epochClicksRemaining) epochClicksRemaining.textContent = "Delta: 0 months (Synchronized)";
                });
            }

            if (fakeLabel1 && chkActiveProfile) {
                fakeLabel1.addEventListener('click', () => {
                    hitboxHint1.classList.remove('hidden');
                    state.snagCount++;
                    playSubtleBeep();
                });
            }

            if (chkReadAccess && chkActiveProfile && checkboxCascadeNotice) {
                chkReadAccess.addEventListener('change', () => {
                    if (chkReadAccess.checked && chkActiveProfile.checked) {
                        chkActiveProfile.checked = false;
                        checkboxCascadeNotice.classList.remove('hidden');
                        state.snagCount++;
                    }
                });
            }

            if (serverNodeSelect) {
                serverNodeSelect.addEventListener('change', () => {
                    const val = serverNodeSelect.value;
                    if (val && val !== "US-East-Node-7" && !state.serverPingFailedOnce && !state.mercyMode) {
                        state.serverPingFailedOnce = true;
                        showError(`Ping verification failed on [${val}]. Remote directory requires US-East-Node-7 or US-East-Legacy.`);
                        serverNodeSelect.value = "US-East-Node-7";
                    }
                });
            }

            if (submitBackupBtn) {
                submitBackupBtn.addEventListener('click', () => {
                    const idVal = playerIdInput ? playerIdInput.value.trim() : '';
                    if (!idVal) {
                        showError("Validation Error: Player ID cannot be empty.");
                        return;
                    }
                    if (!serverNodeSelect || !serverNodeSelect.value) {
                        showError("Validation Error: Target Server Cluster must be selected.");
                        return;
                    }
                    if (!state.dateSynced && state.currentYear < 2020) {
                        showError("Sync Error: Municipal date is too far in the past. Use the system clock override.");
                        return;
                    }
                    if (!chkActiveProfile || !chkActiveProfile.checked || !chkReadAccess || !chkReadAccess.checked) {
                        showError("Affidavit Error: Both municipal overwrite affidavits must be checked.");
                        return;
                    }

                    if (!state.cookieAccepted) {
                        if (cookieBanner) cookieBanner.classList.remove('hidden');
                        state.cookieBannerShown = true;
                        return;
                    }

                    startProcessingSequence();
                });
            }

