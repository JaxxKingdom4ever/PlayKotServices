        (function() {
            const state = {
                startTime: Date.now(),
                snagCount: 0,
                mercyMode: false,
                hasShownTooltip: false,
                tooltipDodges: 0,
                hasClearedOnBlur: false,
                serverPingFailedOnce: false,
                cookieAccepted: false,
