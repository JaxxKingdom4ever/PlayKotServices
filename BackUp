                cookieLegalBox.addEventListener('scroll', () => {
                    const scrolledToBottom = cookieLegalBox.scrollHeight - cookieLegalBox.scrollTop <= cookieLegalBox.clientHeight + 10;
                    if (scrolledToBottom) {
                        acceptCookiesBtn.removeAttribute('disabled');
                        acceptCookiesBtn.textContent = "Accept All & Continue >>";
                    }
                });

                acceptCookiesBtn.addEventListener('click', () => {
                    state.cookieAccepted = true;
                    if (cookieBanner) cookieBanner.classList.add('hidden');
                    startProcessingSequence();
                });
            }

            function startProcessingSequence() {
                if (formContainer) formContainer.classList.add('hidden');
                if (processingContainer) processingContainer.classList.remove('hidden');

                let pct = 2;
                const logs = [
                    "Connecting to Playkot secure shard cluster...",
                    "Allocating 14.2 MB local IndexedDB memory block...",
                    "Fetching virtual municipal zoning records...",
                    "Auditing lighthouse and yacht club permits...",
                    "Compressing simulated pigeon migration logs...",
                    "Writing .SCB header manifest..."
                ];

                const interval = setInterval(() => {
                    if (pct < 84) {
                        pct += Math.floor(Math.random() * 6) + 2;
                        if (pct > 84) pct = 84;
                        if (progressBarFill) progressBarFill.style.width = pct + '%';
                        if (progressPercentText) progressPercentText.textContent = pct + '%';

                        if (pct % 15 === 0 && consoleLogBox) {
                            const logIdx = Math.floor(Math.random() * logs.length);
                            consoleLogBox.innerHTML += `<div>[00:${String(Math.floor(pct/2)).padStart(2,'0')}.14] ${logs[logIdx]}</div>`;
                            consoleLogBox.scrollTop = consoleLogBox.scrollHeight;
                        }
                    } else if (pct === 84 && !state.stallResolved) {
                        clearInterval(interval);
                        if (stallModal) stallModal.classList.remove('hidden');
                    }
                }, 400);
            }

            if (keepWaitingBtn && stallModal) {
                keepWaitingBtn.addEventListener('click', () => {
                    stallModal.classList.add('hidden');
                    state.stallResolved = true;
                    resumeProcessingTo100();
                });
            }

            if (cancelOperationBtn && stallModal) {
                cancelOperationBtn.addEventListener('click', () => {
                    stallModal.classList.add('hidden');
                    state.snagCount++;
                    showError("Operation aborted by user. Re-initiating connection...");
                    setTimeout(() => {
                        resumeProcessingTo100();
                    }, 1200);
                });
            }

            function resumeProcessingTo100() {
                let pct = 84;
                const interval = setInterval(() => {
                    pct += 4;
                    if (progressBarFill) progressBarFill.style.width = pct + '%';
                    if (progressPercentText) progressPercentText.textContent = pct + '%';
                    if (consoleLogBox) {
                        consoleLogBox.innerHTML += `<div>[00:${pct}] Finalizing block checksum verification...</div>`;
                        consoleLogBox.scrollTop = consoleLogBox.scrollHeight;
                    }
                    if (pct >= 100) {
                        clearInterval(interval);
                        setTimeout(() => {
                            if (processingContainer) processingContainer.classList.add('hidden');
                            if (revealContainer) revealContainer.classList.remove('hidden');
                            const mayorNameEl = document.getElementById('finalMayorName');
                            const finalNodeNameEl = document.getElementById('finalNodeName');
                            const finalSnagCountEl = document.getElementById('finalSnagCount');

                            if (mayorNameEl && playerIdInput) mayorNameEl.textContent = playerIdInput.value || "Mayor";
                            if (finalNodeNameEl && serverNodeSelect) finalNodeNameEl.textContent = serverNodeSelect.value || "US-East-Legacy";
                            if (finalSnagCountEl) finalSnagCountEl.textContent = state.snagCount;
                        }, 800);
                    }
                }, 200);
            }
        })();
    </script>
</body>
</html>
